{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(.*)layosgroupllc\\.com"
        }
      ],
      "destination": "https://lms.lglconsultingllc.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!assets/|favicon.ico|index.html).*)",
      "destination": "/index.html"
    }
  ]
}
